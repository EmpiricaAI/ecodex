# ecodex default config.
#
# ecodex writes this file as ~/.codex/config.toml the first time it starts and
# finds no config there. If you already have a config.toml, ecodex leaves it as
# it is and only adds the [plugins."empirica@empiricaAI"] entry below; copy any
# provider block you want from here.
#
# Two parts of ecodex's discipline show here: the empirica plugin is enabled by
# default, and strict mode (set by the binary itself) is described at the end.
# See docs/ecodex/integrations/discipline-strengthening.md.

# ─── The empirica plugin ─────────────────────────────────────────────
# ecodex installs the bundled plugin itself; plugins and their hooks are on by
# default in codex, with no feature flag to set. Set enabled = false to turn the
# plugin off; ecodex respects that and does not switch it back on.

[plugins."empirica@empiricaAI"]
enabled = true

# The plugin also ships Empirica's MCP server. It only wraps the empirica CLI,
# which ecodex runs directly wherever it has a shell, so it is off. Set
# enabled = true for a client without a shell, such as a GUI or web front end.
[plugins."empirica@empiricaAI".mcp_servers.empirica]
enabled = false

# ─── Providers ───────────────────────────────────────────────────────
# Open-weights providers first. docs/ecodex/integrations/providers.md covers
# each one and how to get its key.
#
# codex speaks only the Responses API. A provider whose API speaks only Chat
# Completions has to be reached through the translator that ships with ecodex,
# `codex-empirica-translator`:
#   1. Start it: `codex-empirica-translator` (no flags). It listens on
#      127.0.0.1:18080 and reads its routes from ~/.codex/translator-upstreams.toml,
#      which ecodex writes on first start with routes for Mistral.
#      To keep it running: nohup codex-empirica-translator >~/.codex/translator.log 2>&1 &
#   2. Point the provider's base_url at the translator, not at the provider:
#        base_url = "http://localhost:18080/v1"
#   3. Add a route for the provider's models to translator-upstreams.toml
#      (a model_match pattern, the real base_url, protocol chat or anthropic,
#      and the api_key_env holding the key).
# The translator takes keys from the environment, or from
# ~/.empirica/credentials.yaml (MISTRAL_API_KEY reads mistral.api_key).
# Providers that serve the Responses API themselves (OpenRouter, Hugging Face,
# the local servers below) need no translator. The [model_providers.mistral]
# block is a complete example of a translated provider.
#
# This file sets no default model, so ecodex starts on codex's own default until
# you pick one with `/model` or set `model` and `model_provider` at the top.

# DeepSeek, Qwen, GLM and Kimi speak Chat Completions and Anthropic speaks the
# Messages API, so they go through the translator, which holds their keys: put
# each key in ~/.empirica/credentials.yaml (deepseek / dashscope / zhipu /
# moonshot / anthropic, each with an api_key) or export the variable named in
# translator-upstreams.toml, then
# start `codex-empirica-translator`. Keys: platform.deepseek.com/api_keys,
# dashscope.console.aliyun.com/apiKey, bigmodel.cn/usercenter/proj-mgmt/apikeys,
# platform.moonshot.cn/console/api-keys.

[model_providers.deepseek]
name = "DeepSeek via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

[model_providers.qwen]
name = "Qwen (Alibaba Cloud) via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

[model_providers.glm]
name = "GLM (Zhipu AI) via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

[model_providers.kimi]
name = "Kimi (Moonshot AI) via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

# Anthropic speaks the Messages API, so Claude goes through the translator too:
# put the key in ~/.empirica/credentials.yaml as anthropic.api_key (or export
# ANTHROPIC_API_KEY), start `codex-empirica-translator`, then pick
# claude-sonnet-5-5 (claude-opus-5-5 for the reasoning tier). Keys:
# console.anthropic.com/settings/keys. A Claude subscription does not sign in
# here; this is the metered API.
[model_providers.anthropic]
name = "Anthropic (Claude) via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

# The EU data-sovereignty route. Mistral AI is based in Paris and its API is
# hosted in the EU, so code stays in the EU: the choice for anyone who cannot
# send code to US or Chinese providers. Devstral (devstral-latest, 256K context)
# is the agentic coding model; Codestral (codestral-latest) is the completion
# model. Both are open-weights, so the same models can run on your own EU
# hardware (Ollama, vLLM) with nothing leaving the building.
#
# Setup: put the key in ~/.empirica/credentials.yaml as mistral.api_key (or
# export MISTRAL_API_KEY), start `codex-empirica-translator`, then pick
# devstral-latest. Valid ids include devstral-latest, devstral-2512 and
# devstral-medium-latest; "devstral-2-latest" does not exist.
[model_providers.mistral]
name = "Mistral (EU — Paris) via translator :18080"
base_url = "http://localhost:18080/v1"
wire_api = "responses"

# ─── Local servers ───────────────────────────────────────────────────
# `ollama` (port 11434) and `lmstudio` (port 1234) are built-in providers, found
# on their standard ports with no config. llama.cpp and vLLM are not built in,
# so they are defined below. All four list their models at /v1/models, so
# `ecodex models refresh` can discover what each is serving
# (docs/ecodex/integrations/model-registry.md).

# llama.cpp `llama-server`: 127.0.0.1:8080 by default, one model.
[model_providers.llamacpp]
name = "llama.cpp (local)"
base_url = "http://localhost:8080/v1"
env_key_instructions = "Local llama-server — no auth by default."
wire_api = "responses"

# vLLM `vllm serve`: localhost:8000 by default, one model at a time.
[model_providers.vllm]
name = "vLLM (local)"
base_url = "http://localhost:8000/v1"
env_key_instructions = "Local vLLM server — no auth by default. Set VLLM_API_KEY + uncomment env_key if you started vllm with --api-key."
# env_key = "VLLM_API_KEY"
wire_api = "responses"

[model_providers.openrouter]
name = "OpenRouter"
base_url = "https://openrouter.ai/api/v1"
env_key = "OPENROUTER_API_KEY"
env_key_instructions = "Get an API key at https://openrouter.ai/keys, then export OPENROUTER_API_KEY in your shell or add to ~/.codex/.env."
wire_api = "responses"

# Hugging Face Inference Providers, through its OpenAI-compatible router, which
# serves the Responses API itself. Use a fine-grained token with the "Make calls
# to Inference Providers" permission. The huggingface.config.toml overlay picks
# a model for `ecodex exec -p huggingface`.
[model_providers.huggingface]
name = "Hugging Face Inference Providers"
base_url = "https://router.huggingface.co/v1"
env_key = "HF_TOKEN"
env_key_instructions = "Create a fine-grained token with Inference Providers permission at https://huggingface.co/settings/tokens, then export HF_TOKEN in your shell."
wire_api = "responses"

# ─── OpenAI ──────────────────────────────────────────────────────────
# ecodex leads with open-weights models but does not shut out frontier ones.
# `openai` is a built-in provider id and must not be redefined under
# model_providers. The GPT presets in `/model` select it; it reads
# OPENAI_API_KEY and needs no translator.

# ─── Strict mode ─────────────────────────────────────────────────────
# On by default. The ecodex binary sets these four environment variables to
# true at startup unless they are already set, on every install path; the
# empirica Sentinel reads them from the environment, not from this file. Set
# one to false in your shell or ~/.codex/.env to relax it.
#   EMPIRICA_SENTINEL_REQUIRE_BOOTSTRAP=true
#       No praxic action until `empirica project-bootstrap` has run, so the
#       model loads the project's context before it acts.
#   EMPIRICA_SENTINEL_COMPACT_INVALIDATION=true
#       A context compaction invalidates earlier CHECKs; the model checks again
#       from its post-compaction state.
#   EMPIRICA_SENTINEL_CHECK_EXPIRY=true
#       A CHECK expires after 30 minutes instead of lasting the session.
#   EMPIRICA_CALIBRATION_FEEDBACK=true
#       PREFLIGHT and CHECK show the model its own calibration record.
